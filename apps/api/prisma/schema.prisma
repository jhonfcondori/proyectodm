generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "ts"
}

datasource db {
  provider = "sqlite"
}

enum CampaignStatus {
  ACTIVE
  ARCHIVED
}

model Campaign {
  id          String         @id @default(cuid())
  // Name uniqueness is application-level (service `existsByName` -> 409), not a
  // DB constraint: single-user local app, and a DB unique index would force
  // data-mutating dedupe in migrations. Do not add @@unique([name]) here.
  name        String
  description String?
  status      CampaignStatus @default(ACTIVE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  sessions    Session[]
  entities    Entity[]

  @@index([status, updatedAt])
}

enum SessionStatus {
  DRAFT
  PLAYED
  CLOSED
}

model Session {
  id         String        @id @default(cuid())
  campaignId String
  number     Int
  title      String
  summary    String?
  playedAt   DateTime?
  status     SessionStatus @default(DRAFT)
  // Path of the session note inside the Obsidian vault. Null until the vault
  // module (phase 6) links the session to a note.
  notePath   String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  campaign   Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, number])
  @@index([campaignId, playedAt])
  @@index([campaignId, status])
}

enum EntityType {
  CHARACTER
  NPC
  LOCATION
  ITEM
  FACTION
  DEITY
  VEHICLE
  CREATURE
  OTHER
}

model Entity {
  id         String     @id @default(cuid())
  campaignId String
  type       EntityType
  name       String
  summary    String?
  content    String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  campaign   Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, type, name])
  @@index([campaignId, type])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

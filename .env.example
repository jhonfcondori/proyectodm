# Copy this file to .env and adjust the values. NEVER commit .env.
NODE_ENV=development
PORT=3001
WEB_PORT=5173

# Prisma + SQLite. Relative to prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# Absolute path to your local Obsidian vault. Keep it OUTSIDE this repo.
VAULT_PATH="C:\\path\\to\\your\\vault"
VAULT_SYNC_ENABLED=false

LOG_LEVEL=info
